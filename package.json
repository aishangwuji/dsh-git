{
  "name": "@aishangwuji/dsh-git-plus",
  "version": "0.1.1",
  "type": "module",
  "description": "A Git workbench for DSH workspaces: colored file status, changes tree, commit graph, branch creation, isolated worktree sessions, and fetch/pull/push/commit actions.",
  "license": "MIT",
  "author": "aishangwuji",
  "homepage": "https://github.com/aishangwuji/dsh-git-plus#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aishangwuji/dsh-git-plus.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "git",
    "worktree",
    "diff"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/host.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
