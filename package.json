{
  "name": "@aishangwuji/dsh-git",
  "version": "0.2.1",
  "type": "module",
  "description": "A Git workbench for DSH workspaces: colored file status, changes tree, commit graph, branch creation, isolated worktree sessions, and fetch/pull/push/commit actions.",
  "license": "MIT",
  "author": "aishangwuji",
  "homepage": "https://github.com/aishangwuji/dsh-git#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aishangwuji/dsh-git.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "git",
    "worktree",
    "diff"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "host/*.js",
    "client.js",
    "styles.css",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/host.test.mjs test/client.test.mjs test/invariants.test.mjs",
    "check:render": "node scripts/ssr-check.mjs && node scripts/panel-render-check.mjs",
    "build:client": "node scripts/build-client.mjs",
    "check:client": "node scripts/build-client.mjs --check",
    "check": "npm test && npm run check:render && npm run check:client"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
